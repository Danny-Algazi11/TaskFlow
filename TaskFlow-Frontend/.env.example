# Laravel backend. Must be http://localhost:8000, never 127.0.0.1:8000 —
# the backend's cookie domain and SANCTUM_STATEFUL_DOMAINS are locked to
# "localhost", so the two won't match otherwise (documented gotcha in the
# backend's TASKFLOW_CONTEXT.md).
VITE_API_URL=http://localhost:8000

# Laravel Reverb (self-hosted, Pusher-protocol WebSocket server, pure PHP —
# no Node dependency, unlike Soketi). Must match the backend's
# REVERB_APP_KEY/HOST/PORT/SCHEME in TaskFlow/.env exactly, since Echo
# connects directly to Reverb, not through the Laravel backend's own port.
VITE_REVERB_APP_KEY=taskflow-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
